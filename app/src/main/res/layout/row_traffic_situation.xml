<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/situation_icon"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/rowRoad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/unknown_road"
            android:textColor="@color/navy"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/rowDelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delay_unknown"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/rowType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/accent"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/rowDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/ink"
        android:textSize="15sp" />
</LinearLayout>
