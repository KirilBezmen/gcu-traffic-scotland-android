<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="@string/app_name"
        android:textColor="@color/navy"
        android:textSize="23sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/navigationGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_navigation"
        android:contentDescription="@string/navigation_description"
        android:orientation="horizontal"
        android:padding="5dp">

        <RadioButton
            android:id="@+id/navHome"
            style="@style/TrafficNavigationItem"
            android:checked="true"
            android:text="@string/home" />
        <RadioButton
            android:id="@+id/navIncidents"
            style="@style/TrafficNavigationItem"
            android:text="@string/incidents" />
        <RadioButton
            android:id="@+id/navRoadworks"
            style="@style/TrafficNavigationItem"
            android:text="@string/roadworks" />
        <RadioButton
            android:id="@+id/navMap"
            style="@style/TrafficNavigationItem"
            android:text="@string/map" />
    </RadioGroup>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
