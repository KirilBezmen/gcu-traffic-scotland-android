<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map"
        android:textColor="@color/navy"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/mapSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:text="@string/map_all_count"
        android:textColor="@color/ink"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/mapSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:text="@string/loading"
        android:textColor="@color/subtitle"
        android:textSize="12sp" />
    <Button
        android:id="@+id/clearMapSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clear_selection" />
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">
        <TextView
            android:id="@+id/mapHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="20dp"
            android:text="@string/map_loading"
            android:textColor="@color/subtitle"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
