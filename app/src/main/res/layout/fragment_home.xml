<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:contentDescription="@string/hero_description"
                android:scaleType="fitXY"
                android:src="@drawable/hero_road_scene" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="18dp"
                android:paddingTop="8dp"
                android:text="@string/home_headline"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="18dp"
                android:paddingBottom="20dp"
                android:paddingTop="6dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/pale_blue"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:text="@string/explore_title"
            android:textColor="@color/navy"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/homeIncidents"
                style="@style/TrafficHomeButton"
                android:text="@string/incidents" />
            <Button
                android:id="@+id/homeRoadworks"
                style="@style/TrafficHomeButton"
                android:text="@string/roadworks" />
            <Button
                android:id="@+id/homeMap"
                style="@style/TrafficHomeButton"
                android:text="@string/map" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_overview"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/homeCounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="@string/loading"
                android:textColor="@color/ink"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/homeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/loading"
                android:textColor="@color/subtitle"
                android:textSize="13sp" />
            <Button
                android:id="@+id/homeRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/refresh" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
