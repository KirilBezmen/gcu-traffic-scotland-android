<?xml version="1.0" encoding="utf-8"?>
<!-- One responsive Home screen; the Activity owns the only navigation bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/bg_hero"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:text="@string/home_eyebrow"
            android:textColor="@color/pale_blue" android:textStyle="bold" android:textSize="11sp"/>
        <ImageView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scaleType="fitCenter"
            android:src="@drawable/hero_road_scene" android:contentDescription="@string/hero_description"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:text="@string/home_headline"
            android:textColor="@color/white" android:textSize="27sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp" android:text="@string/home_subtitle"
            android:textColor="@color/pale_blue" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="106dp"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="5dp"
            android:background="@drawable/bg_incident_tile" android:orientation="vertical"
            android:gravity="center_vertical" android:padding="14dp">
            <TextView android:id="@+id/homeIncidentCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textSize="29sp"
                android:textStyle="bold" android:textColor="@color/danger"
                android:accessibilityLiveRegion="polite"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/incidents" android:textColor="@color/navy"
                android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/from_feed" android:textColor="@color/subtitle" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/bg_roadworks_tile" android:orientation="vertical"
            android:gravity="center_vertical" android:padding="14dp">
            <TextView android:id="@+id/homeRoadworkCount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="—" android:textSize="29sp"
                android:textStyle="bold" android:textColor="@color/amber"
                android:accessibilityLiveRegion="polite"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/roadworks" android:textColor="@color/navy"
                android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/from_feed" android:textColor="@color/subtitle" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/bg_card"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/data_overview" android:textColor="@color/navy"
                android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/homeCounts" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/loading"
                android:textColor="@color/ink" android:textSize="12sp"/>
            <TextView android:id="@+id/homeStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                android:text="@string/loading" android:textColor="@color/subtitle" android:textSize="11sp"/>

    <ProgressBar
        android:id="@+id/homeProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:importantForAccessibility="no"
        android:visibility="gone" />
        </LinearLayout>
        <ImageButton android:id="@+id/homeRefresh" android:layout_width="48dp"
            android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh_content_description" android:padding="12dp"
            android:src="@drawable/ic_refresh" android:tint="@color/accent"/>
    </LinearLayout>
</LinearLayout>