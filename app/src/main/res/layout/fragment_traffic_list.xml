<?xml version="1.0" encoding="utf-8"?>
<!-- All controls above situationList stay fixed. Only ListView scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/listTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/incidents"
            android:textColor="@color/navy"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/listRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh_content_description"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/listSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/loading"
        android:textColor="@color/subtitle"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/roadSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/subtitle"
        android:drawablePadding="10dp"
        android:hint="@string/search_road"
        android:inputType="textCapCharacters"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/subtitle"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/nearbyOnly"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="3dp"
        android:buttonTint="@color/accent"
        android:text="@string/nearby_filter"
        android:textColor="@color/navy"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/nearbyRadiusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/radiusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nearby_radius_default"
            android:textColor="@color/subtitle"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/nearbyRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/radius_description"
            android:max="195"
            android:progress="20" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/listCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/results_count_placeholder"
            android:textColor="@color/navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/mapResults"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/map_results"
            android:textAllCaps="false"
            android:backgroundTint="@color/navy"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/situationList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/listEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/loading"
            android:textColor="@color/subtitle"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
