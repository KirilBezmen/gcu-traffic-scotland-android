<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/listTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/incidents"
            android:textColor="@color/navy"
            android:textSize="25sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/listRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/refresh" />
    </LinearLayout>
    <TextView
        android:id="@+id/listSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:text="@string/loading"
        android:textColor="@color/subtitle"
        android:textSize="13sp" />
    <EditText
        android:id="@+id/roadSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:hint="@string/search_road"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/subtitle"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingHorizontal="10dp">
        <CheckBox
            android:id="@+id/nearbyOnly"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/nearby_filter"
            android:textColor="@color/navy" />
        <TextView
            android:id="@+id/radiusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nearby_radius_default"
            android:textColor="@color/subtitle"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/nearbyRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="195"
            android:progress="20"
            android:contentDescription="@string/radius_description" />
    </LinearLayout>
    <TextView
        android:id="@+id/listCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="7dp"
        android:text="@string/results_count_placeholder"
        android:textColor="@color/navy"
        android:textSize="14sp"
        android:textStyle="bold" />
    <ListView
        android:id="@+id/situationList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="9dp"
        android:scrollbars="vertical" />
    <TextView
        android:id="@+id/listEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="@string/loading"
        android:textColor="@color/subtitle"
        android:textSize="15sp" />
</LinearLayout>
