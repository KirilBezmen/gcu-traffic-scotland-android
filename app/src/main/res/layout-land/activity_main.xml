<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/background">
    <!-- Landscape deliberately changes the navigation placement into a left rail. -->
    <LinearLayout android:layout_width="174dp" android:layout_height="match_parent"
        android:paddingHorizontal="10dp" android:paddingVertical="16dp"
        android:background="@color/navy" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:paddingHorizontal="6dp"
            android:text="@string/app_name" android:textColor="@color/white"
            android:textSize="19sp" android:textStyle="bold"/>
        <RadioGroup android:id="@+id/navigationGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:contentDescription="@string/navigation_description">
            <RadioButton android:id="@+id/navHome" style="@style/TrafficNavigationRailItem"
                android:checked="true" android:drawableStart="@drawable/ic_nav_home" android:text="@string/home"/>
            <RadioButton android:id="@+id/navIncidents" style="@style/TrafficNavigationRailItem"
                android:drawableStart="@drawable/ic_nav_incidents" android:text="@string/incidents"/>
            <RadioButton android:id="@+id/navRoadworks" style="@style/TrafficNavigationRailItem"
                android:drawableStart="@drawable/ic_nav_roadworks" android:text="@string/roadworks"/>
            <RadioButton android:id="@+id/navMap" style="@style/TrafficNavigationRailItem"
                android:drawableStart="@drawable/ic_nav_map" android:text="@string/map"/>
        </RadioGroup>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/fragmentHost"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
</LinearLayout>