<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal">
    <!-- Different arrangement from portrait: persistent left-side navigation rail -->
    <LinearLayout
        android:layout_width="196dp"
        android:layout_height="match_parent"
        android:background="@color/navy"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="14dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/navigationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/navigation_description"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/navHome"
                style="@style/TrafficNavigationRailItem"
                android:checked="true"
                android:text="@string/home" />
            <RadioButton
                android:id="@+id/navIncidents"
                style="@style/TrafficNavigationRailItem"
                android:text="@string/incidents" />
            <RadioButton
                android:id="@+id/navRoadworks"
                style="@style/TrafficNavigationRailItem"
                android:text="@string/roadworks" />
            <RadioButton
                android:id="@+id/navMap"
                style="@style/TrafficNavigationRailItem"
                android:text="@string/map" />
        </RadioGroup>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentHost"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
